+@pytest.mark.parametrize("policy", ["lru", "two_queue"])
+def test_agentcache_full_attention_pool_pressure_and_metrics(policy):
+    """Repeated prefixes are reusable; only Two-Queue survives a cold scan."""
+    manager = KVCacheManager(
+        make_kv_cache_config(16, 33), max_model_len=256,
+        gpu_eviction_policy=policy, num_preallocate_tokens=0)
+
+    def call(request_id, tokens):
+        request = make_request(request_id, tokens)
+        cached, computed = manager.get_computed_blocks(request)
+        assert manager.allocate_slots(request, len(tokens) - computed, cached) is not None
+        manager.free(request)
+        return computed
+
+    hot = [42] * 127
+    assert call("first", hot) == 0
+    assert call("repeat", hot) >= 96
+    for i in range(8):
+        assert call(f"cold-{i}", [100 + i] * 127) == 0
+    after = call("after", hot)
+    assert (after >= 96) if policy == "two_queue" else (after == 0)
+    stats = manager.block_pool.policy_stats()
+    assert stats.cold_evictions > 0
+    if policy == "two_queue":
+        assert stats.protected_capacity == 16
+        assert stats.promotions >= 7
+    assert manager.reset_prefix_cache()
+
